<UserControl x:Class="UrbanDiagnosticCentre.Views.SyncSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="Foreground"        Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="Foreground"        Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MonoLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="Foreground"        Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding BackCommand}"
                        Style="{StaticResource GhostButton}"
                        Height="40" Padding="12,0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE830;" FontSize="14" FontFamily="Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Dashboard" FontSize="13" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Sync Settings"
                               FontSize="17" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="White"/>
                    <TextBlock Text="{Binding MachineRole}"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#7EB3F5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,36">

                <!-- MACHINE IDENTITY -->
                <TextBlock Text="MACHINE IDENTITY" Style="{StaticResource SectionLabel}"/>

                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Role" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding MachineRole}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Machine ID" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding MachineIdDisplay}"
                                       Style="{StaticResource MonoLabel}" Margin="0,0,12,0"/>
                            <Button Grid.Column="2" Command="{Binding CopyMachineIdCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Content="Copy" Height="36" Padding="12,0"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Admin note about API key -->
                        <Border Visibility="{Binding IsAdminMachine, Converter={StaticResource BoolToVisibility}}"
                                Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                                CornerRadius="8" Padding="14,11" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontSize="14" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Top" Margin="0,0,10,0"/>
                                <TextBlock FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="The Admin API key is configured in appsettings.json of the SyncService. No changes are needed here on the Admin machine."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- RECEPTION: ADMIN CONNECTION (only on Reception) -->
                <StackPanel Visibility="{Binding IsReception, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="ADMIN CONNECTION" Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Admin API URL" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="e.g. http://192.168.1.10:5432" FontSize="10" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,3,8,0"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding AdminApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         IsEnabled="{Binding IsAdmin}"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         IsEnabled="{Binding IsAdmin}"/>
                            </Grid>

                            <!-- Test status -->
                            <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,14"
                                    Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="#F0FDF4"/>
                                        <Setter Property="BorderBrush"     Value="#86EFAC"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestIsError}" Value="True">
                                                <Setter Property="Background"  Value="#FEF2F2"/>
                                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="&#xE73E;"/>
                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestIsError}" Value="True">
                                                        <Setter Property="Text"       Value="&#xE7BA;"/>
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TestStatus}" FontSize="13" FontFamily="Segoe UI"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding TestCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Content="Test Connection"
                                        Height="40" Padding="16,0"
                                        Margin="0,0,12,0"/>

                                <Button Command="{Binding SaveCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Save Settings"
                                        Height="40" Padding="16,0"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Save status -->
                    <Border CornerRadius="10" Padding="14,11" Margin="0,0,0,20"
                            Visibility="{Binding SaveStatus, Converter={StaticResource StringToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"      Value="#F0FDF4"/>
                                <Setter Property="BorderBrush"     Value="#86EFAC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                        <Setter Property="Background"  Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SaveStatus}" FontSize="13" FontFamily="Segoe UI">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- SYNC STATUS -->
                    <TextBlock Text="SYNC STATUS" Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="State"       Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SyncStateLabel}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Message"     Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SyncMessage}" Style="{StaticResource ValueLabel}" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Last Sync"   Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LastSyncDisplay}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pending"     Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PendingCount}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Failures"    Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConsFailures}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <Grid Visibility="{Binding RetryDelay, Converter={StaticResource StringToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Next Retry"  Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding RetryDelay}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
