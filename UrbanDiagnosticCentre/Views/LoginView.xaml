<UserControl x:Class="UrbanDiagnosticCentre.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <helpers:InverseBoolConverter        x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left branding panel ===== -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="40">

                <Border Width="90" Height="90" CornerRadius="45"
                        Background="White" Margin="0,0,0,28"
                        HorizontalAlignment="Center">
                    <TextBlock Text="UDC" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Urban Diagnostic"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Text="Centre"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Width="60" Height="2"
                        Background="{StaticResource PrimaryLightBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Precision Diagnostics · Trusted Results"
                           FontSize="13" Foreground="#B3D9F9"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="✓  Fully Offline System"
                               FontSize="13" Foreground="#90CAF9" Margin="0,6"/>
                    <TextBlock Text="✓  Secure Role-Based Access"
                               FontSize="13" Foreground="#90CAF9" Margin="0,6"/>
                    <TextBlock Text="✓  Fast Report Generation"
                               FontSize="13" Foreground="#90CAF9" Margin="0,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Right login form ===== -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="12" Padding="48,40"
                    Margin="60" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                      Color="#000000" Opacity="0.08"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Sign In"
                               Style="{StaticResource HeadingLarge}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Enter your credentials to access the system"
                               Style="{StaticResource BodyText}"
                               Margin="0,0,0,36"/>

                    <!-- Username -->
                    <TextBlock Text="USERNAME" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource InputField}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20"/>

                    <!-- Password -->
                    <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource PasswordField}"
                                 Margin="0,0,0,8"
                                 KeyDown="PasswordBox_KeyDown"/>

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage,
                                   Converter={StaticResource StringToVisibility}}"/>

                    <!-- Login button -->
                    <Button x:Name="LoginButton"
                            Content="SIGN IN"
                            Style="{StaticResource PrimaryButton}"
                            Click="LoginButton_Click"
                            IsEnabled="{Binding IsLoggingIn,
                                Converter={StaticResource InverseBool}}"
                            Margin="0,4,0,0"/>

                    <TextBlock Text="v1.0.0 · Urban Diagnostic Centre"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,28,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
