<UserControl x:Class="UrbanDiagnosticCentre.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">
    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Border Background="{StaticResource PrimaryBrush}" Opacity="0.18" HorizontalAlignment="Right" Width="3"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="44,0">
                    <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="Ω6" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OMEGA 6.0" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <Border Width="48" Height="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,16,0,16" CornerRadius="1"/>
                    <TextBlock Text="Universal business management platform" FontSize="12" FontFamily="Segoe UI" Foreground="#7EB3F5" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Margin="0,36,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"><TextBlock Text="&#xE73E;" FontSize="11" FontWeight="Bold" FontFamily="Segoe MDL2 Assets" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Fully Offline System" FontSize="13" FontFamily="Segoe UI" Foreground="#A8C8F0" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"><TextBlock Text="&#xE73E;" FontSize="11" FontWeight="Bold" FontFamily="Segoe MDL2 Assets" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Secure Role-Based Access" FontSize="13" FontFamily="Segoe UI" Foreground="#A8C8F0" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"><TextBlock Text="&#xE73E;" FontSize="11" FontWeight="Bold" FontFamily="Segoe MDL2 Assets" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Fast Business Workflow" FontSize="13" FontFamily="Segoe UI" Foreground="#A8C8F0" VerticalAlignment="Center"/></StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="48,44" Margin="56" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="4" Color="#000000" Opacity="0.07"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Welcome back" Style="{StaticResource HeadingLarge}" Margin="0,0,0,4"/>
                    <TextBlock Text="Sign in to access OMEGA 6.0" Style="{StaticResource BodyText}" Margin="0,0,0,32"/>
                    <TextBlock Text="USERNAME" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="UsernameBox" Style="{StaticResource InputField}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18}"/>
                    <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordField}" Margin="0,0,0,10" KeyDown="PasswordBox_KeyDown"/>
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontSize="13" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="13" FontFamily="Segoe UI" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel></Border>
                    <Button x:Name="LoginButton" Content="Sign In" Style="{StaticResource PrimaryButton}" Height="46" Click="LoginButton_Click" IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBool}}" Margin="0,4,0,0"/>
                    <TextBlock Text="v1.0.0 · OMEGA 6.0" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,28,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
