<UserControl x:Class="UrbanDiagnosticCentre.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <!-- Active/inactive tab button -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActiveTabButton" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- Amount badge colours -->
        <Style x:Key="PositiveAmount" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style x:Key="NegativeAmount" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource ErrorBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,20">
                    <Border Width="44" Height="44" CornerRadius="11"
                            Background="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="UDC" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Urban Diagnostic" FontSize="14" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Centre" FontSize="14" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                    <Border Height="1" Background="#14FFFFFF" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Nav label -->
                <TextBlock DockPanel.Dock="Top" Text="NAVIGATION"
                           FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="#4A6FA5" Margin="20,0,16,8"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,0">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToDashboardCommand}" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontSize="17" Width="26" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="#7EB3F5"/>
                            <TextBlock Text="Dashboard" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToPatientsCommand}" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontSize="15" Width="26" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock Text="Patients" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToTestManagerCommand}" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9CE;" FontSize="15" Width="26" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock Text="Tests" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Accounts — active highlight -->
                    <Border Background="#18FFFFFF" CornerRadius="8" Margin="0,2">
                        <Button Style="{StaticResource GhostButton}" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BF;" FontSize="15" Width="26" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="#7EB3F5"/>
                                <TextBlock Text="Accounts" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToBackupCommand}" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontSize="15" Width="26" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock Text="Backup &amp; Restore" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToSettingsCommand}" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontSize="15" Width="26" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Admin section -->
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="#14FFFFFF" Margin="4,12,4,12"/>
                        <TextBlock Text="ADMINISTRATION" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#4A6FA5" Margin="6,0,0,8"/>
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding NavigateToMaintenanceCommand}" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontSize="15" Width="26" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                <TextBlock Text="Maintenance" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Rectangle DockPanel.Dock="Bottom" Height="0"/>

                <!-- User profile card -->
                <Border DockPanel.Dock="Bottom" Background="#12FFFFFF" BorderBrush="#18FFFFFF"
                        BorderThickness="0,1,0,0" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding UserInitials}" FontSize="13" FontWeight="Bold"
                                       FontFamily="Segoe UI" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelcomeMessage}" FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRole}" FontSize="11" FontFamily="Segoe UI" Foreground="#7EB3F5"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding LogoutCommand}" ToolTip="Sign Out"
                                Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="&#xE8FB;" FontSize="15" FontFamily="Segoe MDL2 Assets" Foreground="#7EB3F5"/>
                        </Button>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== Main content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Grid Grid.Row="0" Margin="32,28,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Accounts" Style="{StaticResource HeadingLarge}"/>
                    <TextBlock Text="Financial management &amp; reporting"
                               Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ShowExportCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Content="&#xE749;  Export PDF" Width="150"
                        VerticalAlignment="Center" Height="40"/>
            </Grid>

            <!-- Tab strip -->
            <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                    Margin="32,16,32,0">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ShowSummaryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSummaryTab}" Value="True">
                                        <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        Summary
                    </Button>
                    <Button Command="{Binding ShowIncomeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIncomeTab}" Value="True">
                                        <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        Income
                    </Button>
                    <Button Command="{Binding ShowExpensesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpensesTab}" Value="True">
                                        <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        Expenses
                    </Button>
                    <Button Command="{Binding ShowTransactionsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransactionsTab}" Value="True">
                                        <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        Transactions
                    </Button>
                    <Button Command="{Binding ShowExportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExportTab}" Value="True">
                                        <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        Export
                    </Button>
                </StackPanel>
            </Border>

            <!-- Tab content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,32">

                    <!-- ── SUMMARY TAB ── -->
                    <StackPanel Visibility="{Binding IsSummaryTab, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="TODAY'S SNAPSHOT" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Today Income -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TODAY'S INCOME" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TodayIncome, StringFormat='₹ {0:N2}'}"
                                               FontSize="32" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,4"/>
                                    <TextBlock Text="from completed reports" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <!-- Today Expenses -->
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="TODAY'S EXPENSES" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TodayExpenses, StringFormat='₹ {0:N2}'}"
                                               FontSize="32" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,4"/>
                                    <TextBlock Text="manually recorded" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <!-- Total Transactions -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL TRANSACTIONS" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalTransactions}"
                                               FontSize="32" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,4"/>
                                    <TextBlock Text="all time" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="THIS MONTH" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Month Income -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MONTH INCOME" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding MonthIncome, StringFormat='₹ {0:N2}'}"
                                               FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,4"/>
                                </StackPanel>
                            </Border>
                            <!-- Month Expenses -->
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="MONTH EXPENSES" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding MonthExpenses, StringFormat='₹ {0:N2}'}"
                                               FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,4"/>
                                </StackPanel>
                            </Border>
                            <!-- Net P&L -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="NET PROFIT / LOSS" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding NetProfitLoss, StringFormat='₹ {0:N2}'}"
                                               FontSize="28" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,8,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetPositive}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="month to date" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ── INCOME TAB ── -->
                    <StackPanel Visibility="{Binding IsIncomeTab, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding IncomeFrom}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding IncomeTo}"/>
                        </Grid>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Diagnostic Revenue" Style="{StaticResource HeadingMedium}" Margin="0,0,0,14"/>
                                <Border Height="1" Background="{StaticResource DividerBrush}"/>
                                <!-- Headers -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Report Code" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8,0,8"/>
                                    <TextBlock Grid.Column="1" Text="Patient" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8,0,8"/>
                                    <TextBlock Grid.Column="2" Text="Date" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8,0,8"/>
                                    <TextBlock Grid.Column="3" Text="Amount" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8,0,8"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding IncomeList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                                                <Grid Height="44">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ReportCode}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientName}" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat='dd MMM yyyy'}" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='₹ {0:N2}'}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── EXPENSES TAB ── -->
                    <StackPanel Visibility="{Binding IsExpensesTab, Converter={StaticResource BoolToVisibility}}">
                        <!-- Add expense form -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Record New Expense" Style="{StaticResource HeadingMedium}" Margin="0,0,0,16"/>

                                <!-- Error banner -->
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,0,12"
                                        Visibility="{Binding HasExpenseError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ExpenseError}" Foreground="{StaticResource ErrorBrush}" FontSize="13" FontFamily="Segoe UI"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Date, Category, Amount -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Date" Style="{StaticResource LabelText}"/>
                                        <DatePicker SelectedDate="{Binding ExpenseDate}" Height="44"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Category" Style="{StaticResource LabelText}"/>
                                        <ComboBox ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding ExpenseCategory}"
                                                  Height="44" FontFamily="Segoe UI" FontSize="14" Padding="10,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Amount (₹)" Style="{StaticResource LabelText}"/>
                                        <TextBox Style="{StaticResource InputField}" Text="{Binding ExpenseAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Row 2: Description (full width) -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Description" Style="{StaticResource LabelText}"/>
                                        <TextBox Style="{StaticResource InputField}" Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Row 4: Notes + Save button -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                                        <TextBlock Text="Notes (optional)" Style="{StaticResource LabelText}"/>
                                        <TextBox Style="{StaticResource InputField}" Text="{Binding ExpenseNotes, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                        <Button Command="{Binding AddExpenseCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="44" Content="Save Expense"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Expense list date filter -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ExpensesFrom}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding ExpensesTo}"/>
                        </Grid>

                        <!-- Expense rows -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Recorded Expenses" Style="{StaticResource HeadingMedium}" Margin="0,0,0,14"/>
                                <Border Height="1" Background="{StaticResource DividerBrush}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                    <TextBlock Grid.Column="1" Text="Category" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                    <TextBlock Grid.Column="2" Text="Description" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                    <TextBlock Grid.Column="3" Text="Amount" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ExpenseList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                                                <Grid Height="48">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TransactionDate, StringFormat='dd MMM yy'}" FontSize="12" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="#F0F4F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource PrimaryBrush}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding Description}" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Notes}" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding Notes, Converter={StaticResource StringToVisibility}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='₹ {0:N2}'}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="4"
                                                            Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                                            ToolTip="Delete">
                                                        <TextBlock Text="&#xE74D;" FontSize="13" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ErrorBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── TRANSACTIONS TAB ── -->
                    <StackPanel Visibility="{Binding IsTransactionsTab, Converter={StaticResource BoolToVisibility}}">
                        <!-- Filters -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding LedgerFrom}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding LedgerTo}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="4" Text="Type:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                            <ComboBox Grid.Column="5" ItemsSource="{Binding TypeFilters}"
                                      SelectedItem="{Binding LedgerTypeFilter}"
                                      Height="40" FontFamily="Segoe UI" FontSize="13" Padding="10,0"/>
                        </Grid>

                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Transaction Ledger" Style="{StaticResource HeadingMedium}" Margin="0,0,0,14"/>
                                <Border Height="1" Background="{StaticResource DividerBrush}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                    <TextBlock Grid.Column="1" Text="Type" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                    <TextBlock Grid.Column="2" Text="Category" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                    <TextBlock Grid.Column="3" Text="Description" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                    <TextBlock Grid.Column="4" Text="Amount" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,8"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LedgerList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                                                <Grid Height="46">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='dd MMM yyyy'}" FontSize="12" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <!-- Type badge -->
                                                    <Border Grid.Column="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="12" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat='₹ {0:N2}'}" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── EXPORT TAB ── -->
                    <StackPanel Visibility="{Binding IsExportTab, Converter={StaticResource BoolToVisibility}}" MaxWidth="560" HorizontalAlignment="Left">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="28">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Export Financial Report" Style="{StaticResource HeadingMedium}" Margin="0,0,0,6"/>
                                <TextBlock Text="Generate a professional PDF covering income, expenses, and the full transaction ledger."
                                           Style="{StaticResource BodyText}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                                <TextBlock Text="Reporting Period" Style="{StaticResource LabelText}"/>
                                <ComboBox ItemsSource="{Binding ExportRanges}"
                                          SelectedItem="{Binding ExportRange}"
                                          Height="44" FontFamily="Segoe UI" FontSize="14" Padding="10,0"
                                          Margin="0,0,0,16"/>

                                <!-- Custom date range (visible only for Custom) -->
                                <Grid Visibility="{Binding IsCustomExportRange, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start Date" Style="{StaticResource LabelText}"/>
                                        <DatePicker SelectedDate="{Binding ExportFrom}" Height="44"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Bottom"
                                               HorizontalAlignment="Center" Margin="0,0,0,10"
                                               Style="{StaticResource BodyText}"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="End Date" Style="{StaticResource LabelText}"/>
                                        <DatePicker SelectedDate="{Binding ExportTo}" Height="44"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Period preview -->
                                <Border Background="#EBF3FF" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE787;" FontSize="15" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            <Run Text="{Binding ExportFrom, StringFormat='dd MMM yyyy', Mode=OneWay}"/>
                                            <Run Text=" – "/>
                                            <Run Text="{Binding ExportTo, StringFormat='dd MMM yyyy', Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Button Command="{Binding ExportPdfCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="48" FontSize="14"
                                        IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;" FontSize="16" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Export PDF Report"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                            <Setter Property="Text" Value="Generating…"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
