<UserControl x:Class="UrbanDiagnosticCentre.Views.PatientReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><helpers:StringToVisibilityConverter x:Key="StringToVisibility"/></UserControl.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource GhostButton}" Content="← Dashboard" Height="40" Padding="12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0"><TextBlock Text="{Binding PageTitle}" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="OMEGA 6.0 · Create a new customer record" FontSize="11" Foreground="#7EB3F5"/></StackPanel>
                <Button Grid.Column="2" Command="{Binding SaveDraftCommand}" Style="{StaticResource GhostButton}" Content="Save Draft" Height="40" Padding="16,0"/>
                <Button Grid.Column="4" Command="{Binding CompleteReportCommand}" Style="{StaticResource PrimaryButton}" Content="Finish" Height="40" Padding="20,0"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="22" Margin="0,0,0,16">
                <StackPanel><TextBlock Text="CUSTOMER DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Customer Name *" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Customer Code *" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormAge, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" ToolTip="Enter a unique customer code"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Contact *" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Account Owner" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormReferringDoctor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Address / Notes" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="18">
                    <StackPanel><TextBlock Text="ADD SERVICES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Category" Style="{StaticResource LabelText}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="40" Margin="0,0,0,12"/>
                        <ListBox ItemsSource="{Binding AvailableTests}" SelectedItem="{Binding SelectedAvailableTest}" Height="280"><ListBox.ItemTemplate><DataTemplate><Border Padding="8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TestName}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Add" Command="{Binding DataContext.AddTestCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource RowActionButton}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <TextBlock Text="Create your own services from the Service Builder. This workspace starts empty." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="18">
                    <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="SELECTED SERVICES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding AvailableTiers}" SelectedItem="{Binding SelectedTier}" Height="38" Margin="0,0,0,12" ToolTip="Optional pricing tier"/></StackPanel>
                        <ItemsControl ItemsSource="{Binding SelectedEntries}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding TestDef.TestName}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding TestDef.Category}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><TextBox Grid.Column="1" Text="{Binding ResultText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Height="36" ToolTip="Enter a value"/><TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/><Button Grid.Column="3" Content="Remove" Command="{Binding DataContext.RemoveTestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource RowActionButton}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalChargeDisplay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/><Border Background="#FEF2F2" CornerRadius="8" Padding="10" Margin="0,12,0,0" Visibility="{Binding FormError, Converter={StaticResource StringToVisibility}}"><TextBlock Text="{Binding FormError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/></Border></StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>