<UserControl x:Class="UrbanDiagnosticCentre.Views.PatientReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers"
             PreviewKeyDown="PatientReport_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:StringToBrushConverter x:Key="StringToBrush"/>

        <Style x:Key="ReadOnlyField" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Padding"         Value="12,0"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background"      Value="#F0F4F9"/>
            <Setter Property="BorderBrush"     Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="12,9"/>
        </Style>

        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Height"   Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding"  Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"   Value="Hand"/>
        </Style>

        <Style x:Key="TestItem" TargetType="ListBoxItem">
            <Setter Property="Padding"  Value="0"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Width"          Value="30"/>
            <Setter Property="Height"         Value="30"/>
            <Setter Property="FontSize"       Value="18"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="Background"     Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Margin"         Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveBtn" TargetType="Button">
            <Setter Property="Width"          Value="28"/>
            <Setter Property="Height"         Value="28"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Foreground"     Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DraftButton" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Background"      Value="#18FFFFFF"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#3A5A84"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.IsEnabled>
            <Binding Path="IsSaving" Converter="{StaticResource InverseBool}"/>
        </Grid.IsEnabled>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding NavigateToDashboardCommand}"
                        Style="{StaticResource DraftButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE830;" FontSize="14" FontFamily="Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Dashboard" FontSize="13" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="New Report"
                               FontSize="17" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="White"/>
                    <TextBlock Text="{Binding ReportCodeDisplay}"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#7EB3F5"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding SaveDraftCommand}"
                        Style="{StaticResource DraftButton}"
                        Content="Save as Draft"
                        TabIndex="8"/>

                <Button Grid.Column="4"
                        Command="{Binding CompleteReportCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="40" Padding="20,0" FontSize="13"
                        TabIndex="9">
                    <Button.Content>
                        <TextBlock FontFamily="Segoe UI">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Complete Report"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                            <Setter Property="Text" Value="Saving…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">

                <!-- Patient Information -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        Padding="24" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="PATIENT INFORMATION" Style="{StaticResource SectionHeading}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Patient Name *" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         TabIndex="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Age *" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding FormAge, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         TabIndex="2"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <TextBlock Text="Gender" Style="{StaticResource LabelText}"/>
                                <StackPanel Orientation="Horizontal" Height="44">
                                    <RadioButton Content="Male"
                                                 IsChecked="{Binding GenderIsMale}"
                                                 GroupName="Gender"
                                                 FontSize="14" FontFamily="Segoe UI"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,20,0" Cursor="Hand"/>
                                    <RadioButton Content="Female"
                                                 IsChecked="{Binding GenderIsFemale}"
                                                 GroupName="Gender"
                                                 FontSize="14" FontFamily="Segoe UI"
                                                 VerticalAlignment="Center"
                                                 Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Phone Number *" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         TabIndex="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Referring Doctor" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding FormReferringDoctor, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         TabIndex="6"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Address" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         TabIndex="7"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Report Code" Style="{StaticResource LabelText}"/>
                                <Border Style="{StaticResource ReadOnlyField}">
                                    <TextBlock Text="{Binding ReportCodeDisplay}"
                                               FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Test Date" Style="{StaticResource LabelText}"/>
                                <Border Style="{StaticResource ReadOnlyField}">
                                    <TextBlock Text="{Binding TestDateDisplay}"
                                               FontSize="13" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Report Date" Style="{StaticResource LabelText}"/>
                                <Border Style="{StaticResource ReadOnlyField}">
                                    <TextBlock Text="{Binding ReportDateDisplay}"
                                               FontSize="13" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Test Selection -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        Padding="24" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="TEST SELECTION" Style="{StaticResource SectionHeading}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvailableTiers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Price Category:"
                                       FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableTiers}"
                                      SelectedItem="{Binding SelectedTier}"
                                      Height="38" FontSize="13" FontFamily="Segoe UI" Padding="8,0"/>
                            <TextBlock Grid.Column="3"
                                       FontSize="13" FontFamily="Segoe UI"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Run Text="Total: "/>
                                <Run Text="{Binding TotalChargeDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>

                        <Grid Height="360">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="195"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Categories -->
                            <Border Grid.Column="0"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"
                                            CornerRadius="10,10,0,0">
                                        <TextBlock Text="CATEGORY" FontSize="10" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <ListBox ItemsSource="{Binding Categories}"
                                             SelectedItem="{Binding SelectedCategory}"
                                             BorderThickness="0"
                                             Background="{StaticResource CardBrush}"
                                             ItemContainerStyle="{StaticResource CategoryItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </DockPanel>
                            </Border>

                            <!-- Available Tests -->
                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"
                                            CornerRadius="10,10,0,0">
                                        <TextBlock Text="AVAILABLE TESTS" FontSize="10" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <ListBox ItemsSource="{Binding AvailableTests}"
                                             SelectedItem="{Binding SelectedAvailableTest}"
                                             BorderThickness="0"
                                             Background="{StaticResource CardBrush}"
                                             ItemContainerStyle="{StaticResource TestItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="42" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TestName}"
                                                               FontSize="13" FontFamily="Segoe UI"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,8,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TestName}"/>
                                                    <Button Grid.Column="1"
                                                            Content="+"
                                                            Style="{StaticResource AddBtn}"
                                                            Command="{Binding DataContext.AddTestCommand,
                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Selected Tests & Results -->
                            <Border Grid.Column="4"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"
                                            CornerRadius="10,10,0,0">
                                        <TextBlock Text="SELECTED TESTS &amp; RESULTS" FontSize="10" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>

                                    <!-- Table header -->
                                    <Grid DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                                          Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Test"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Reference Range"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="Result"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="3" Text="Flag"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Price"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Margin="0,0,6,0"/>
                                    </Grid>

                                    <!-- Empty state -->
                                    <Border DockPanel.Dock="Bottom"
                                            Visibility="{Binding HasNoSelectedEntries, Converter={StaticResource BoolToVisibility}}"
                                            VerticalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#x2190; Select tests from the list"
                                                       FontSize="14" FontFamily="Segoe UI"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Click the + button next to a test to add it"
                                                       FontSize="12" FontFamily="Segoe UI"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rows -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedEntries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="50" Background="{StaticResource CardBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="190"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="36"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.ColumnSpan="6"
                                                                VerticalAlignment="Bottom"
                                                                Height="1"
                                                                Background="{StaticResource DividerBrush}"/>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding TestDef.TestName}"
                                                                   FontSize="13" FontFamily="Segoe UI"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,8,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding TestDef.TestName}"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding RangeDisplay}"
                                                                   FontSize="12" FontFamily="Segoe UI"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,8,0"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <Border Grid.Column="2"
                                                                Margin="4,6" VerticalAlignment="Center"
                                                                BorderBrush="{StaticResource DividerBrush}"
                                                                BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource CardBrush}">
                                                            <TextBox Text="{Binding ResultText,
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0"
                                                                     Background="Transparent"
                                                                     FontSize="13" FontFamily="Segoe UI"
                                                                     Padding="8,6"
                                                                     VerticalContentAlignment="Center">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="TextBox">
                                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                                                  Padding="{TemplateBinding Padding}"
                                                                                                  VerticalAlignment="Center"/>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                        </Border>

                                                        <Border Grid.Column="3"
                                                                Background="{Binding FlagBackground,
                                                                    Converter={StaticResource StringToBrush}}"
                                                                CornerRadius="6"
                                                                Margin="4,10"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FlagDisplay}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       FontFamily="Segoe UI"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{Binding FlagColor,
                                                                           Converter={StaticResource StringToBrush}}"
                                                                       Padding="6,4"/>
                                                        </Border>

                                                        <Border Grid.Column="4"
                                                                Margin="2,8" VerticalAlignment="Center"
                                                                BorderBrush="{StaticResource DividerBrush}"
                                                                BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource CardBrush}">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                                        Visibility="{Binding IsPriceOverridden, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.ResetPriceCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="20" FontSize="10"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                                        Cursor="Hand"
                                                                        ToolTip="Reset to tier price"/>
                                                                <TextBox Text="{Binding PriceEditText, UpdateSourceTrigger=PropertyChanged}"
                                                                         BorderThickness="0" Background="Transparent"
                                                                         FontSize="12" FontWeight="SemiBold"
                                                                         FontFamily="Segoe UI"
                                                                         Foreground="{StaticResource PrimaryBrush}"
                                                                         VerticalContentAlignment="Center"
                                                                         TextAlignment="Right"
                                                                         Padding="4,2"
                                                                         ToolTip="Enter a custom price, or clear to use tier pricing">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="TextBox">
                                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                                                      Padding="{TemplateBinding Padding}"
                                                                                                      VerticalAlignment="Center"/>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </DockPanel>
                                                        </Border>

                                                        <Button Grid.Column="5"
                                                                Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                Style="{StaticResource RemoveBtn}"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveTestCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Saving indicator -->
                <Border Background="#EBF3FF" CornerRadius="10" Padding="16,12"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;  " FontSize="14" FontFamily="Segoe MDL2 Assets"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SavingMessage}"
                                   FontSize="13" FontFamily="Segoe UI"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Validation error -->
                <Border Background="#FEF2F2" CornerRadius="10" Padding="16,12"
                        Visibility="{Binding FormError, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;  " FontSize="14" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource ErrorBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormError}"
                                   FontSize="13" FontFamily="Segoe UI"
                                   Foreground="{StaticResource ErrorBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
