<Window x:Class="UrbanDiagnosticCentre.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urban Diagnostic Centre"
        Height="750" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">

    <!--
        WindowChrome replaces OS-rendered non-client area entirely.
        CaptionHeight=32   — the full title-bar row is the drag target.
        ResizeBorderThickness=5 — keeps resize hit-testing at all edges/corners,
                                   preserving Aero Snap and standard resizing.
        UseAeroCaptionButtons=False — tells DWM not to paint its own buttons;
                                       our custom buttons handle all three commands.
        GlassFrameThickness=0 — no Aero glass bleed into client area.
        CornerRadius=0 — square corners; Windows 11 DWM rounds them at the OS level.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Minimize / Maximize chrome button base style -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width"          Value="46"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable"      Value="False"/>
            <!--
                IsHitTestVisibleInChrome=True is mandatory for any button
                that sits inside the CaptionHeight region. Without it, clicks
                are consumed by the drag/double-click logic and never reach
                the button's Click event.
            -->
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button — Windows-red hover state -->
        <Style x:Key="ChromeCloseButton" TargetType="Button">
            <Setter Property="Width"          Value="46"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable"      Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9B2218"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--
        DockPanel root: title bar docked to top, ContentControl fills the rest.
    -->
    <DockPanel>

        <!-- ===== Custom title bar ===== -->
        <Grid DockPanel.Dock="Top"
              Height="32"
              Background="{StaticResource PrimaryDarkBrush}">

            <!-- App name — acts as drag handle -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <TextBlock Text="UDC"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBlock Text="Urban Diagnostic Centre"
                           Foreground="#B0C8E8"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Control buttons — right-aligned -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <!-- Minimize -->
                <Button Style="{StaticResource ChromeButton}"
                        Click="MinimizeButton_Click">
                    <TextBlock Text="0"
                               FontFamily="Marlett"
                               FontSize="10"
                               Foreground="#B0C8E8"/>
                </Button>

                <!-- Maximize / Restore — glyph switches on WindowState -->
                <Button Style="{StaticResource ChromeButton}"
                        Click="MaximizeRestoreButton_Click">
                    <TextBlock FontFamily="Marlett"
                               FontSize="10"
                               Foreground="#B0C8E8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState,
                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Text" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Close -->
                <Button Style="{StaticResource ChromeCloseButton}"
                        Click="CloseButton_Click">
                    <TextBlock Text="r"
                               FontFamily="Marlett"
                               FontSize="10"
                               Foreground="#B0C8E8"/>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ===== Main content ===== -->
        <ContentControl Content="{Binding CurrentViewModel}"
                        Focusable="False"/>

    </DockPanel>
</Window>
