<Window x:Class="UrbanDiagnosticCentre.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urban Diagnostic Centre"
        Height="750" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">

    <!--
        WindowChrome replaces OS-rendered non-client area entirely.
        CaptionHeight=32   — the full title-bar row is the drag target.
        ResizeBorderThickness=5 — keeps resize hit-testing at all edges/corners,
                                   preserving Aero Snap and standard resizing.
        UseAeroCaptionButtons=False — tells DWM not to paint its own buttons;
                                       our custom buttons handle all three commands.
        GlassFrameThickness=0 — no Aero glass bleed into client area.
        CornerRadius=0 — square corners; Windows 11 DWM rounds them at the OS level.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Base style shared by Minimize and Maximize/Restore buttons. -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width"          Value="46"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable"      Value="False"/>
            <!--
                IsHitTestVisibleInChrome=True is mandatory for any button
                that sits inside the CaptionHeight region. Without it, clicks
                are consumed by the drag/double-click logic and never reach
                the button's Click event.
            -->
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button uses the same dimensions but Windows-red hover state. -->
        <Style x:Key="ChromeCloseButton" TargetType="Button">
            <Setter Property="Width"          Value="46"/>
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable"      Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B01F10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--
        DockPanel root: title bar docked to top, ContentControl fills the rest.
        This is the only structural change to what was previously a bare
        <ContentControl/> as the sole child of the Window.
    -->
    <DockPanel>

        <!-- ===== Custom title bar ===== -->
        <Grid DockPanel.Dock="Top"
              Height="32"
              Background="{StaticResource PrimaryDarkBrush}">

            <!-- App name — sits in the CaptionHeight region, acts as drag handle. -->
            <TextBlock Text="Urban Diagnostic Centre"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>

            <!-- Control buttons — right-aligned, 46×32 each. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <!-- Minimize -->
                <Button Style="{StaticResource ChromeButton}"
                        Click="MinimizeButton_Click">
                    <!--
                        Marlett is a Windows system font (present since Windows 95)
                        whose glyphs map directly to the caption-button symbols:
                        '0' = minimize line, '1' = maximize square,
                        '2' = restore (overlapping squares), 'r' = close ×.
                    -->
                    <TextBlock Text="0"
                               FontFamily="Marlett"
                               FontSize="10"
                               Foreground="White"/>
                </Button>

                <!-- Maximize / Restore — glyph switches automatically on WindowState. -->
                <Button Style="{StaticResource ChromeButton}"
                        Click="MaximizeRestoreButton_Click">
                    <TextBlock FontFamily="Marlett"
                               FontSize="10"
                               Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- Default: show maximize glyph -->
                                <Setter Property="Text" Value="1"/>
                                <Style.Triggers>
                                    <!--
                                        When the window is maximized, switch to the
                                        restore-down glyph automatically. No code-behind
                                        needed; the DataTrigger reads the Window's own
                                        WindowState via RelativeSource.
                                    -->
                                    <DataTrigger Binding="{Binding WindowState,
                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Text" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Close -->
                <Button Style="{StaticResource ChromeCloseButton}"
                        Click="CloseButton_Click">
                    <TextBlock Text="r"
                               FontFamily="Marlett"
                               FontSize="10"
                               Foreground="White"/>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ===== Main content (unchanged binding) ===== -->
        <ContentControl Content="{Binding CurrentViewModel}"
                        Focusable="False"/>

    </DockPanel>
</Window>
