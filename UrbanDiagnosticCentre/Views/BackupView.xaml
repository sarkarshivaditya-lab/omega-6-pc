<UserControl x:Class="UrbanDiagnosticCentre.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <!-- Action card -->
        <Style x:Key="ActionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1"
                                      Color="#000000" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline (browse) button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EBF3FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning (orange) button for Restore -->
        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B45309"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success (green) button for Open Folder -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding BackCommand}"
                        Style="{StaticResource GhostButton}"
                        Height="40" Padding="12,0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE830;" FontSize="14"
                                   FontFamily="Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Dashboard" FontSize="13"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Backup &amp; Restore"
                               FontSize="17" FontWeight="Bold"
                               FontFamily="Segoe UI" Foreground="White"/>
                    <TextBlock Text="Safeguard your data — create backups and restore when needed"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#7EB3F5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,32">

                <!-- Section label -->
                <TextBlock Text="DATA MANAGEMENT"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,14"/>

                <!-- ── Three action cards ── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1 – Create Backup -->
                    <Border Grid.Column="0" Style="{StaticResource ActionCard}"
                            Background="#EBF3FF" Margin="0,0,10,0"
                            BorderBrush="#BFDBFE" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#DBEAFE" CornerRadius="10"
                                    Width="44" Height="44" HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <TextBlock Text="&#xE74E;" FontSize="22"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Create Backup"
                                       FontSize="16" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Save a complete copy of all patient data and PDF reports to a ZIP file."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <TextBlock Text="SAVE TO FOLDER" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding BackupDestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}" Height="40" FontSize="12"
                                         IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Click="BrowseDestination_Click"
                                        Content="Browse…" Height="40"
                                        Style="{StaticResource OutlineButton}"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </Grid>

                            <!-- Disk space warning for destination drive -->
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="10,7"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding HasDestinationDiskWarning, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontSize="12"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource WarningBrush}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DestinationDiskWarning}"
                                               FontSize="12" FontFamily="Segoe UI"
                                               Foreground="{StaticResource WarningBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44"
                                    IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontSize="14"
                                               FontFamily="Segoe MDL2 Assets"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Create Backup" FontSize="13"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Card 2 – Restore Backup -->
                    <Border Grid.Column="1" Style="{StaticResource ActionCard}"
                            Background="#FFFBEB" Margin="5,0,5,0"
                            BorderBrush="#FCD34D" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#FEF3C7" CornerRadius="10"
                                    Width="44" Height="44" HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <TextBlock Text="&#xE7BA;" FontSize="22"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Restore from Backup"
                                       FontSize="16" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Restores all data from a backup ZIP. A safety snapshot is created automatically before restoring."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Border Background="#FEF3C7" CornerRadius="6" Padding="10,7"
                                    Margin="0,0,0,14" BorderBrush="#FCD34D" BorderThickness="1">
                                <TextBlock Text="Warning: all current data will be replaced."
                                           FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="SELECT BACKUP FILE (.ZIP)"
                                       Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding RestoreSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}" Height="40" FontSize="12"
                                         IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Click="BrowseRestoreFile_Click"
                                        Content="Browse…" Height="40"
                                        Style="{StaticResource OutlineButton}"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </Grid>

                            <Button Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource WarningButton}"
                                    IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontSize="14"
                                               FontFamily="Segoe MDL2 Assets"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Restore Backup" FontSize="13"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Card 3 – Open Backup Folder -->
                    <Border Grid.Column="2" Style="{StaticResource ActionCard}"
                            Background="#F0FDF4" Margin="10,0,0,0"
                            BorderBrush="#BBF7D0" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#DCFCE7" CornerRadius="10"
                                    Width="44" Height="44" HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <TextBlock Text="&#xE838;" FontSize="22"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Open Backup Folder"
                                       FontSize="16" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Browse your saved backups in File Explorer. Connect a USB drive to copy backups off-site."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <TextBlock Text="CURRENT BACKUP LOCATION"
                                       Style="{StaticResource SectionLabel}"/>
                            <Border Background="#DCFCE7" CornerRadius="8"
                                    Padding="10,8" Margin="0,0,0,14">
                                <TextBlock Text="{Binding BackupDestinationFolder}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="#15803D"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Button Command="{Binding OpenBackupFolderCommand}"
                                    Style="{StaticResource SuccessButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontSize="14"
                                               FontFamily="Segoe MDL2 Assets"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open Folder" FontSize="13"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Status message ── -->
                <Border CornerRadius="10" Padding="14,11" Margin="0,0,0,20"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"    Value="#F0FDF4"/>
                            <Setter Property="BorderBrush"   Value="#86EFAC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Background"    Value="#FEF2F2"/>
                                    <Setter Property="BorderBrush"   Value="#FCA5A5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="&#xE73E;"/>
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Text"       Value="&#xE7BA;"/>
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13" FontFamily="Segoe UI"
                                   TextWrapping="Wrap" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── Recent Backups ── -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2"
                                          Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recent Backups"
                                       Style="{StaticResource HeadingMedium}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RecentBackups.Count, StringFormat='{}{0} recorded'}"
                                       Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource DividerBrush}"/>

                        <!-- Empty state -->
                        <StackPanel Margin="0,24,0,8" HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoRecentBackups, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="No backups recorded yet."
                                       FontSize="14" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Create your first backup using the button above."
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Table -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoRecentBackups}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <!-- Column headers -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date &amp; Time"
                                               FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Padding="0,6"/>
                                    <TextBlock Grid.Column="1" Text="Size"
                                               FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Padding="0,6"/>
                                    <TextBlock Grid.Column="2" Text="Type"
                                               FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Padding="0,6"/>
                                    <TextBlock Grid.Column="3" Text="Path"
                                               FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Padding="0,6"/>
                                </Grid>

                                <!-- Rows -->
                                <ItemsControl ItemsSource="{Binding RecentBackups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid Height="46">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="185"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding BackupDate, StringFormat='dd MMM yyyy, hh:mm tt'}"
                                                               FontSize="13" FontFamily="Segoe UI"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SizeDisplay}"
                                                               FontSize="13" FontFamily="Segoe UI"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                                    <!-- Type badge -->
                                                    <Border Grid.Column="2" VerticalAlignment="Center"
                                                            CornerRadius="6" Padding="7,3"
                                                            HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EBF3FF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAutoBackup}" Value="True">
                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   FontFamily="Segoe UI">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource PrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAutoBackup}" Value="True">
                                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding BackupPath}"
                                                               FontSize="12" FontFamily="Segoe UI"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding BackupPath}"
                                                               Margin="0,0,8,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
