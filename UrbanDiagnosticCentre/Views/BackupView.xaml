<UserControl x:Class="UrbanDiagnosticCentre.Views.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">
<UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><helpers:InverseBoolConverter x:Key="InverseBool"/></UserControl.Resources>
<Grid Background="{StaticResource BackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}" Content="← Dashboard" Height="40" Padding="12,0" Margin="0,0,20,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Data Backup &amp; Restore" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="Protect your OMEGA 6.0 workspace" FontSize="11" Foreground="#7EB3F5"/></StackPanel></Grid></Border>
<ScrollViewer Grid.Row="1"><StackPanel Margin="32,24"><TextBlock Text="DATA MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="22"><StackPanel><TextBlock Text="CREATE BACKUP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="Save a complete copy of your workspace." FontSize="16" FontWeight="Bold" Margin="0,6,0,16"/><TextBlock Text="DESTINATION" Style="{StaticResource LabelText}"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding BackupDestinationFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Height="40" IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}" Margin="0,0,6,0"/><Button Grid.Column="1" Content="Browse…" Height="40" Style="{StaticResource OutlineButton}" Click="BrowseDestination_Click"/></Grid><Button Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Height="44" Content="Create Backup" IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/></StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="22"><StackPanel><TextBlock Text="RESTORE BACKUP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="Restore your workspace from a saved backup." FontSize="16" FontWeight="Bold" Margin="0,6,0,16"/><TextBlock Text="BACKUP FILE" Style="{StaticResource LabelText}"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding RestoreSourcePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Height="40" IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}" Margin="0,0,6,0"/><Button Grid.Column="1" Content="Browse…" Height="40" Style="{StaticResource OutlineButton}" Click="BrowseRestoreFile_Click"/></Grid><Button Command="{Binding RestoreBackupCommand}" Style="{StaticResource PrimaryButton}" Height="44" Content="Restore Backup" IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/></StackPanel></Border></Grid>
<Border Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="20" Margin="0,18,0,0"><StackPanel><TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource OutlineButton}" Content="Open Backup Folder" Height="40" Width="170" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></Grid></UserControl>