<UserControl x:Class="UrbanDiagnosticCentre.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <!-- Action card -->
        <Style x:Key="ActionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.07"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline (browse) button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning (orange) button for Restore -->
        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E65100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BF360C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success (green) button for Open Folder -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding BackCommand}"
                        Style="{StaticResource GhostButton}"
                        Height="40" Padding="12,0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2190;" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Dashboard" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Backup &amp; Restore" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Safeguard your data — create backups and restore when needed"
                               FontSize="11" Foreground="#90CAF9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,28,36,36">

                <!-- Section label -->
                <TextBlock Text="DATA MANAGEMENT" Style="{StaticResource SectionLabel}" Margin="0,0,0,14"/>

                <!-- ── Three action cards ── -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1 – Create Backup -->
                    <Border Grid.Column="0" Style="{StaticResource ActionCard}"
                            Background="#E3F2FD" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F4BE;" FontSize="38" Margin="0,0,0,10"/>
                            <TextBlock Text="Create Backup" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="Save a complete copy of all patient data and PDF reports to a ZIP file."
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="SAVE TO FOLDER" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding BackupDestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}" Height="38" FontSize="12"
                                         IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Click="BrowseDestination_Click"
                                        Content="Browse…" Height="38"
                                        Style="{StaticResource OutlineButton}"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </Grid>

                            <!-- Disk space warning for destination drive -->
                            <Border Background="#FFF3E0" CornerRadius="4" Padding="10,7"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding HasDestinationDiskWarning, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x26A0;" FontSize="13" Foreground="#E65100"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DestinationDiskWarning}"
                                               FontSize="12" Foreground="#E65100"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="&#x1F4BE;   Create Backup"
                                    IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2 – Restore Backup -->
                    <Border Grid.Column="1" Style="{StaticResource ActionCard}"
                            Background="#FFF3E0" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="&#x26A0;" FontSize="38" Foreground="#E65100" Margin="0,0,0,10"/>
                            <TextBlock Text="Restore from Backup" FontSize="18" FontWeight="Bold"
                                       Foreground="#E65100" Margin="0,0,0,5"/>
                            <TextBlock Text="Restores all data from a backup ZIP. A safety snapshot is created automatically before restoring."
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <Border Background="#FFCCBC" CornerRadius="4" Padding="9,6" Margin="0,0,0,16">
                                <TextBlock Text="Warning: all current data will be replaced."
                                           FontSize="12" FontWeight="SemiBold" Foreground="#BF360C"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="SELECT BACKUP FILE (.ZIP)" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding RestoreSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}" Height="38" FontSize="12"
                                         IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Click="BrowseRestoreFile_Click"
                                        Content="Browse…" Height="38"
                                        Style="{StaticResource OutlineButton}"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </Grid>

                            <Button Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource WarningButton}"
                                    Content="&#x26A0;   Restore Backup"
                                    IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3 – Open Backup Folder -->
                    <Border Grid.Column="2" Style="{StaticResource ActionCard}"
                            Background="#E8F5E9" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F4C2;" FontSize="38" Margin="0,0,0,10"/>
                            <TextBlock Text="Open Backup Folder" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="Browse your saved backups in File Explorer. Connect a USB drive to copy backups off-site."
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="CURRENT BACKUP LOCATION" Style="{StaticResource SectionLabel}"/>
                            <Border Background="#C8E6C9" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                                <TextBlock Text="{Binding BackupDestinationFolder}"
                                           FontSize="12" Foreground="#2E7D32"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Button Command="{Binding OpenBackupFolderCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    Content="&#x1F4C2;   Open Folder"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Status message ── -->
                <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,22"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E8F5E9"/>
                            <Setter Property="BorderBrush" Value="#A5D6A7"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x2714;"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Text" Value="&#x26A0;"/>
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                   TextWrapping="Wrap" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── Recent Backups ── -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recent Backups"
                                       Style="{StaticResource HeadingMedium}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RecentBackups.Count, StringFormat='{}{0} recorded'}"
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource DividerBrush}"/>

                        <!-- Empty state -->
                        <StackPanel Margin="0,24,0,8" HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoRecentBackups, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="No backups recorded yet." FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Create your first backup using the button above."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Table (hidden when empty) -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoRecentBackups}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <!-- Column headers -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date &amp; Time"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,6,0,6"/>
                                    <TextBlock Grid.Column="1" Text="Size"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,6,0,6"/>
                                    <TextBlock Grid.Column="2" Text="Type"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,6,0,6"/>
                                    <TextBlock Grid.Column="3" Text="Path"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0,6,0,6"/>
                                </Grid>

                                <!-- Rows -->
                                <ItemsControl ItemsSource="{Binding RecentBackups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid Height="46">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="185"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding BackupDate, StringFormat='dd MMM yyyy, hh:mm tt'}"
                                                               FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SizeDisplay}"
                                                               FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                                    <!-- Type badge -->
                                                    <Border Grid.Column="2" VerticalAlignment="Center"
                                                            CornerRadius="4" Padding="7,3" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAutoBackup}" Value="True">
                                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                   FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource PrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAutoBackup}" Value="True">
                                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding BackupPath}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding BackupPath}"
                                                               Margin="0,0,8,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
