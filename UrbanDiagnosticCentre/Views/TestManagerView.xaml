<UserControl x:Class="UrbanDiagnosticCentre.Views.TestManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F0F4F9"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="14,11"/>
            <Setter Property="BorderBrush"     Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EBF3FF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F4F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding NavigateToDashboardCommand}"
                        Style="{StaticResource GhostButton}"
                        Height="40" Padding="12,0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE830;" FontSize="14" FontFamily="Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Dashboard" FontSize="13" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Test Manager"
                               FontSize="17" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="White"/>
                    <TextBlock Text="Manage diagnostic test definitions"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#7EB3F5"/>
                </StackPanel>

                <!-- Search box -->
                <Border Grid.Column="2" BorderBrush="#3A5A84" BorderThickness="1"
                        CornerRadius="8" Background="#18FFFFFF" VerticalAlignment="Center">
                    <Grid Width="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontSize="13"
                                   FontFamily="Segoe MDL2 Assets"
                                   Margin="10,0,6,0" VerticalAlignment="Center"
                                   Foreground="#7EB3F5"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38" FontSize="13" FontFamily="Segoe UI"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Padding="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Add button -->
                <Button Grid.Column="4"
                        Command="{Binding AddNewCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Content="+ Add New Test" Width="148"/>
            </Grid>
        </Border>

        <!-- ===== Content area ===== -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid card -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding Tests}"
                          SelectedItem="{Binding SelectedTest}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowBackground="{StaticResource CardBrush}"
                          AlternatingRowBackground="{StaticResource SurfaceBrush}"
                          BorderThickness="0"
                          Background="{StaticResource CardBrush}"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          CellStyle="{StaticResource GridCell}"
                          RowHeight="46">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Test Name"
                                            Binding="{Binding TestName}"
                                            Width="*"
                                            MinWidth="160"/>

                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Sample Type"
                                            Binding="{Binding SampleType}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Unit"
                                            Binding="{Binding Unit}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Male Range"
                                            Binding="{Binding MaleRange}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Female Range"
                                            Binding="{Binding FemaleRange}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Child Range"
                                            Binding="{Binding ChildRange}"
                                            Width="110"/>

                        <DataGridTemplateColumn Header="Actions" Width="130" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0">
                                        <Button Content="Edit"
                                                Style="{StaticResource RowActionButton}"
                                                Background="#EBF3FF"
                                                BorderBrush="#BFDBFE"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                Command="{Binding DataContext.EditCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Archive"
                                                Style="{StaticResource RowActionButton}"
                                                Background="#FFFBEB"
                                                BorderBrush="#FCD34D"
                                                Foreground="{StaticResource WarningBrush}"
                                                Command="{Binding DataContext.ArchiveCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Form panel -->
            <Border Grid.Column="1"
                    Width="380"
                    Margin="14,0,0,0"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#000000" Opacity="0.05"/>
                </Border.Effect>

                <DockPanel>

                    <!-- Form header -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                            Padding="20,16">
                        <TextBlock Text="{Binding FormTitle}"
                                   FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Save / Cancel buttons pinned to bottom -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                            Padding="20,14">
                        <StackPanel>
                            <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding FormError, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding FormError}"
                                           FontSize="13" FontFamily="Segoe UI"
                                           Foreground="{StaticResource ErrorBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource OutlineButton}"
                                        Content="Cancel"/>
                                <Button Grid.Column="2"
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="44" FontSize="13"
                                        Content="Save Test"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Form fields (scrollable) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,0">
                        <StackPanel>

                            <TextBlock Text="Test Name *" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding FormTestName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputField}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Category *" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding FormCategory, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputField}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Sample Type *" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding FormSampleType, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputField}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Unit *" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding FormUnit, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputField}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Decimal Precision" Style="{StaticResource LabelText}"/>
                            <ComboBox SelectedIndex="{Binding FormDecimalPrecision}"
                                      Height="44" FontSize="13" FontFamily="Segoe UI"
                                      Margin="0,0,0,20"
                                      Padding="10,0">
                                <ComboBoxItem>0 decimal places</ComboBoxItem>
                                <ComboBoxItem>1 decimal place</ComboBoxItem>
                                <ComboBoxItem>2 decimal places</ComboBoxItem>
                                <ComboBoxItem>3 decimal places</ComboBoxItem>
                            </ComboBox>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>
                            <TextBlock Text="REFERENCE RANGES" FontSize="10" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Male Range (Min / Max)" Style="{StaticResource LabelText}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FormMaleMin, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                                <TextBlock Grid.Column="1" Text="–" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding FormMaleMax, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                            </Grid>

                            <TextBlock Text="Female Range (Min / Max)" Style="{StaticResource LabelText}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FormFemaleMin, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                                <TextBlock Grid.Column="1" Text="–" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding FormFemaleMax, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                            </Grid>

                            <TextBlock Text="Child Range (Min / Max)" Style="{StaticResource LabelText}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FormChildMin, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                                <TextBlock Grid.Column="1" Text="–" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding FormChildMax, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4,0,16"/>
                            <TextBlock Text="Notes" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="13" FontFamily="Segoe UI"
                                     Padding="12,10"
                                     BorderBrush="{StaticResource DividerBrush}"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Top"
                                     Margin="0,0,0,20">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{StaticResource CardBrush}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Padding="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- PRICING (edit mode only) -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>

                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="PRICING TIERS" FontSize="10" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Prices}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TierName}"
                                                           FontSize="13" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PriceDisplay}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           FontFamily="Segoe UI"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,8,0"/>
                                                <Button Grid.Column="2"
                                                        Content="&#xE711;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Width="28" Height="28" FontSize="12"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" VerticalAlignment="Center"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Command="{Binding DataContext.DeletePriceCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add price row -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding FormPriceTierName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputField}"
                                             Height="40" FontSize="13">
                                        <TextBox.ToolTip>Tier name (e.g. Regular)</TextBox.ToolTip>
                                    </TextBox>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding FormPriceAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputField}"
                                             Height="40" FontSize="13">
                                        <TextBox.ToolTip>Price amount</TextBox.ToolTip>
                                    </TextBox>
                                    <Button Grid.Column="4"
                                            Content="Add"
                                            Command="{Binding AddPriceCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="40" FontSize="13" Padding="12,0"/>
                                </Grid>

                                <Border Background="#FEF2F2" CornerRadius="8" Padding="10,7"
                                        Margin="0,4,0,0"
                                        Visibility="{Binding HasPriceFormError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding PriceFormError}"
                                               FontSize="12" FontFamily="Segoe UI"
                                               Foreground="{StaticResource ErrorBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
