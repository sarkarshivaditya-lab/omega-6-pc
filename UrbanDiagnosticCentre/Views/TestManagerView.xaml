<UserControl x:Class="UrbanDiagnosticCentre.Views.TestManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource GhostButton}" Content="← Dashboard" Height="40" Padding="12,0" Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Service Builder" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="Create and manage your own reusable services" FontSize="11" Foreground="#7EB3F5"/></StackPanel>
                <Button Grid.Column="2" Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButton}" Content="+ Create Your Own" Height="40" Padding="18,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Height="40" ToolTip="Search your services"/></Border>
                    <DataGrid ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" Background="{StaticResource CardBrush}" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding TestName}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Input Type" Binding="{Binding SampleType}" Width="140"/>
                            <DataGridTextColumn Header="Format" Binding="{Binding Unit}" Width="100"/>
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource RowActionButton}" Margin="0,0,6,0"/>
                                    <Button Content="Archive" Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource RowActionButton}"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Width="390" Margin="14,0,0,0" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource HeadingMedium}" Margin="0,0,0,20"/>
                    <TextBlock Text="Service Name *" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormTestName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Margin="0,0,0,14}"/>
                    <TextBlock Text="Category *" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Margin="0,0,0,14}"/>
                    <TextBlock Text="Input Type *" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormSampleType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Margin="0,0,0,14}"/>
                    <TextBlock Text="Unit / Format *" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Margin="0,0,0,14}"/>
                    <TextBlock Text="Decimal Precision" Style="{StaticResource LabelText}"/><ComboBox SelectedIndex="{Binding FormDecimalPrecision}" Height="40" Margin="0,0,0,14"><ComboBoxItem>0</ComboBoxItem><ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem></ComboBox>
                    <TextBlock Text="Custom Option Ranges" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,12"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Option A — Min" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormMaleMin}" Style="{StaticResource InputField}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Option A — Max" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormMaleMax}" Style="{StaticResource InputField}"/></StackPanel></Grid>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Option B — Min" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormFemaleMin}" Style="{StaticResource InputField}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Option B — Max" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormFemaleMax}" Style="{StaticResource InputField}"/></StackPanel></Grid>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Option C — Min" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormChildMin}" Style="{StaticResource InputField}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Option C — Max" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormChildMax}" Style="{StaticResource InputField}"/></StackPanel></Grid>
                    <TextBlock Text="Notes" Style="{StaticResource LabelText}"/><TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="10" Margin="0,0,0,14" Visibility="{Binding FormError, Converter={StaticResource StringToVisibility}}"><TextBlock Text="{Binding FormError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/></Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Content="Cancel"/><Button Grid.Column="2" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Content="Save Service"/></Grid>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>