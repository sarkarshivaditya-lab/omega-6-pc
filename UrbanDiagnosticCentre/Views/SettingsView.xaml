<UserControl x:Class="UrbanDiagnosticCentre.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><helpers:InverseBoolConverter x:Key="InverseBool"/></UserControl.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}" Content="← Dashboard" Height="40" Padding="12,0" Margin="0,0,20,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Workspace Settings" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="Configure your OMEGA 6.0 workspace" FontSize="11" Foreground="#7EB3F5"/></StackPanel><Border Grid.Column="2" CornerRadius="6" Padding="12,5" Background="#18FFFFFF" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Admin" FontSize="12" FontWeight="SemiBold" Foreground="#7EB3F5"/></Border></Grid></Border>
        <ScrollViewer Grid.Row="1"><StackPanel Margin="32,24,32,36">
            <Border Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVisibility}}" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,24"><StackPanel><TextBlock Text="Admin Access Required" FontSize="14" FontWeight="Bold"/><TextBlock Text="Workspace settings can only be modified by an Administrator. You can still change your own password." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="WORKSPACE IDENTITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20"><StackPanel>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Workspace Name" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding CentreName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Address" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding CentreAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10"/></Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Phone" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding CentrePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Email" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding CentreEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></Grid>
                </StackPanel></Border>
                <TextBlock Text="DOCUMENT CUSTOMIZATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20"><StackPanel>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Logo Image" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Margin="0,0,8,0"/><Button Grid.Column="2" Click="BrowseLogo_Click" Content="Browse…" Style="{StaticResource OutlineButton}" Width="90"/></Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Footer Note" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding SignatureFooterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Watermark Text" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputField}"/></Grid>
                </StackPanel></Border>
            </StackPanel>
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>