<UserControl x:Class="UrbanDiagnosticCentre.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <!-- Section heading label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,14"/>
        </Style>

        <!-- Form row label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="Foreground"          Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <!-- Future-ready field label (subdued) -->
        <Style x:Key="FutureFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="#BDBDBD"/>
        </Style>

        <!-- Browse button (outline) -->
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Height"          Value="46"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding BackCommand}"
                        Style="{StaticResource GhostButton}"
                        Height="40" Padding="12,0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2190;" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Dashboard" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Settings &amp; Branding" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding LastSavedDisplay}" FontSize="11" Foreground="#90CAF9"/>
                </StackPanel>

                <!-- Admin badge -->
                <Border Grid.Column="2" CornerRadius="4" Padding="10,4" VerticalAlignment="Center"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background><SolidColorBrush Color="#1AFFFFFF"/></Border.Background>
                    <TextBlock Text="Admin" FontSize="12" FontWeight="SemiBold" Foreground="#90CAF9"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Content (single scroll for all roles) ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,28,36,36">

                <!-- Non-admin notice (inline — admin settings hidden below) -->
                <Border Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVisibility}}"
                        Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                        CornerRadius="10" Padding="18,14" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x1F512;" FontSize="26"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Admin Access Required"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,3"/>
                            <TextBlock Text="Organisation settings can only be modified by an Administrator. You can still change your own password below."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Admin settings (admin only) -->
                <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">

                    <!-- ── ORGANISATION & BRANDING ── -->
                    <TextBlock Text="ORGANISATION &amp; BRANDING" Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Centre Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="1"
                                           Text="{Binding CentreName, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource InputField}"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Address" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <TextBox   Grid.Column="1"
                                           Text="{Binding CentreAddress, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource InputField}" Height="72"
                                           AcceptsReturn="True" TextWrapping="Wrap"
                                           VerticalContentAlignment="Top" Padding="12,10"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phone" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="1"
                                           Text="{Binding CentrePhone, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource InputField}"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Email" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="1"
                                           Text="{Binding CentreEmail, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource InputField}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Logo Image" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Column="1"
                                           Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource InputField}"
                                           Margin="0,0,8,0"/>
                                <Button    Grid.Column="2"
                                           Click="BrowseLogo_Click"
                                           Content="Browse…"
                                           Style="{StaticResource BrowseButton}"
                                           Width="90"/>
                            </Grid>
                            <TextBlock Text="PNG or JPG recommended. Appears in the top-left of printed PDF reports."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="160,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── PDF DEFAULTS ── -->
                    <TextBlock Text="PDF DEFAULTS" Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,10,0,0">
                                    <TextBlock Text="Footer Note" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="(replaces default disclaimer)"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,3,8,0"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SignatureFooterText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}" Height="64"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" Padding="12,10"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="GST / Tax ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="future-ready" FontSize="10" Foreground="#BDBDBD"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding GstTaxId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Watermark Text" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="future-ready" FontSize="10" Foreground="#BDBDBD"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── PRICING ── -->
                    <TextBlock Text="PRICING" Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Default Price Tier" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="applied to new reports" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,3,8,0"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding DefaultPriceTier, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"/>
                            </Grid>
                            <TextBlock Text="Must match a tier name configured in Test Manager (e.g. Regular, Community). Leave blank to disable auto-selection."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="160,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── STORAGE LOCATIONS ── -->
                    <TextBlock Text="STORAGE LOCATIONS" Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Reports Folder" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ReportsRootPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         Margin="0,0,8,0"/>
                                <Button  Grid.Column="2"
                                         Click="BrowseReportsFolder_Click"
                                         Content="Browse…"
                                         Style="{StaticResource BrowseButton}"
                                         Width="90"/>
                            </Grid>
                            <TextBlock Text="Leave blank to use the default location (%LocalAppData%\UrbanDiagnosticCentre\Reports)."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="160,0,0,16"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Backups Folder" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding BackupsRootPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputField}"
                                         Margin="0,0,8,0"/>
                                <Button  Grid.Column="2"
                                         Click="BrowseBackupsFolder_Click"
                                         Content="Browse…"
                                         Style="{StaticResource BrowseButton}"
                                         Width="90"/>
                            </Grid>
                            <TextBlock Text="Leave blank to use the default location (Documents\UDC Backups)."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="160,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── BACKUP STATUS ── -->
                    <TextBlock Text="BACKUP STATUS" Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,12"
                                    Visibility="{Binding HasBackupReminder, Converter={StaticResource BoolToVisibility}}"
                                    Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x26A0;" FontSize="16" Foreground="#E65100"
                                               VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding BackupReminderMessage}"
                                               FontSize="13" Foreground="#E65100"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Backup status is up to date."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBackupReminder}" Value="True">
                                                <Setter Property="Text" Value="Go to Backup &amp; Restore to create a new backup."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Save status -->
                    <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,16"
                            Visibility="{Binding SaveStatusMessage, Converter={StaticResource StringToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"      Value="#E8F5E9"/>
                                <Setter Property="BorderBrush"     Value="#A5D6A7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                        <Setter Property="Background"  Value="#FFEBEE"/>
                                        <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="&#x2714;"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                                <Setter Property="Text"       Value="&#x26A0;"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SaveStatusMessage}" FontSize="13" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Save button -->
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Content="&#x1F4BE;   Save Settings"
                            HorizontalAlignment="Right"
                            Width="200"
                            Margin="0,0,0,28"/>

                </StackPanel>

                <!-- ── ACCOUNT SECURITY (all users) ── -->
                <TextBlock Text="ACCOUNT SECURITY" Style="{StaticResource SectionLabel}"/>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>

                        <TextBlock Text="{Binding PasswordChangeForDisplay}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Default password warning — visible until password is changed -->
                        <Border Visibility="{Binding IsUsingDefaultPassword, Converter={StaticResource BoolToVisibility}}"
                                Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1"
                                CornerRadius="8" Padding="14,11" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;" FontSize="16" Foreground="#E65100"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock FontSize="13" Foreground="#E65100" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Text="You are using a default password. Please change it now to secure this account."/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Current Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Grid.Column="1" x:Name="PwCurrent"
                                         Style="{StaticResource PasswordField}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="New Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Grid.Column="1" x:Name="PwNew"
                                         Style="{StaticResource PasswordField}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Grid.Column="1" x:Name="PwConfirm"
                                         Style="{StaticResource PasswordField}"/>
                        </Grid>

                        <TextBlock Text="Minimum 6 characters."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="160,0,0,16"/>

                        <!-- Password change status -->
                        <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,16"
                                Visibility="{Binding HasPwChangeStatus, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"      Value="#E8F5E9"/>
                                    <Setter Property="BorderBrush"     Value="#A5D6A7"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PwChangeIsError}" Value="True">
                                            <Setter Property="Background"  Value="#FFEBEE"/>
                                            <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"       Value="&#x2714;"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PwChangeIsError}" Value="True">
                                                    <Setter Property="Text"       Value="&#x26A0;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding PwChangeStatus}" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PwChangeIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Click="ChangePassword_Click"
                                Style="{StaticResource PrimaryButton}"
                                Content="Change Password"
                                Width="180"
                                HorizontalAlignment="Left"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
