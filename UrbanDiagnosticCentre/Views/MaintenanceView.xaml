<UserControl x:Class="UrbanDiagnosticCentre.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>

        <!-- Operation card -->
        <Style x:Key="OpCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1"
                                      Color="#000000" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Run button -->
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <!-- ===== ACCESS DENIED (non-admin) ===== -->
        <Grid Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="20"
                        Background="#EBF3FF" HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <TextBlock Text="&#xE72E;" FontSize="36"
                               FontFamily="Segoe MDL2 Assets"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Admin Access Required"
                           FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Maintenance tools are restricted to administrators."
                           FontSize="14" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="210" Height="44">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE830;" FontSize="14"
                                   FontFamily="Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Back to Dashboard" FontSize="13"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== ADMIN CONTENT ===== -->
        <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    Height="64" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}"
                            Height="40" Padding="12,0"
                            Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE830;" FontSize="14"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Dashboard" FontSize="13"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Maintenance"
                                   FontSize="17" FontWeight="Bold"
                                   FontFamily="Segoe UI" Foreground="White"/>
                        <TextBlock Text="Database diagnostics and storage management tools"
                                   FontSize="11" FontFamily="Segoe UI"
                                   Foreground="#7EB3F5"/>
                    </StackPanel>

                    <!-- Working indicator -->
                    <Border Grid.Column="2" VerticalAlignment="Center"
                            Background="#18FFFFFF" CornerRadius="6"
                            Padding="12,6"
                            Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Working…"
                                   FontSize="12" FontFamily="Segoe UI"
                                   Foreground="#7EB3F5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,32">

                    <!-- Status message bar -->
                    <Border CornerRadius="10" Padding="14,11" Margin="0,0,0,22"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"      Value="#F0FDF4"/>
                                <Setter Property="BorderBrush"     Value="#86EFAC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Background"  Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                        <Setter Property="Background"  Value="#EBF3FF"/>
                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="&#xE73E;"/>
                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Text"       Value="&#xE7BA;"/>
                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="Text"       Value="&#xE916;"/>
                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13" FontFamily="Segoe UI"
                                       TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Section label -->
                    <TextBlock Text="DIAGNOSTIC TOOLS"
                               FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,14"/>

                    <!-- 2×2 Operation cards -->
                    <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Integrity Check -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource OpCard}"
                                Background="#EBF3FF"
                                BorderBrush="#BFDBFE">
                            <StackPanel>
                                <Border Background="#DBEAFE" CornerRadius="10"
                                        Width="44" Height="44" HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE721;" FontSize="22"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Integrity Check"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Runs SQLite PRAGMA integrity_check to verify the database has no corruption."
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <Button Command="{Binding IntegrityCheckCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="{StaticResource PrimaryBrush}"
                                        Content="Run Integrity Check"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Find Missing PDFs -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource OpCard}"
                                Background="#FFFBEB"
                                BorderBrush="#FCD34D">
                            <StackPanel>
                                <Border Background="#FEF3C7" CornerRadius="10"
                                        Width="44" Height="44" HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE8A5;" FontSize="22"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Find Missing PDFs"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Finds reports whose PDF is recorded in the database but the file is absent on disk."
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <Button Command="{Binding FindMissingPdfsCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="{StaticResource WarningBrush}"
                                        Content="Scan for Missing PDFs"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Find Orphan PDFs -->
                        <Border Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource OpCard}"
                                Background="#F5F3FF"
                                BorderBrush="#DDD6FE">
                            <StackPanel>
                                <Border Background="#EDE9FE" CornerRadius="10"
                                        Width="44" Height="44" HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE74D;" FontSize="22"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Find Orphan PDFs"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="#7C3AED"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Finds PDF files on disk that have no matching report record in the database."
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <Button Command="{Binding FindOrphanPdfsCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="#7C3AED"
                                        Content="Scan for Orphan PDFs"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Database Vacuum -->
                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource OpCard}"
                                Background="#F0FDF4"
                                BorderBrush="#BBF7D0">
                            <StackPanel>
                                <Border Background="#DCFCE7" CornerRadius="10"
                                        Width="44" Height="44" HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE72C;" FontSize="22"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Database Vacuum"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Rebuilds the database file to reclaim unused space and defragment pages."
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <Button Command="{Binding VacuumCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="{StaticResource SuccessBrush}"
                                        Content="Run Vacuum"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Result details -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24"
                            Visibility="{Binding HasResultDetails, Converter={StaticResource BoolToVisibility}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2"
                                              Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="DETAILS"
                                       FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,10"/>
                            <Border Height="1" Background="{StaticResource DividerBrush}"
                                    Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding ResultDetails}" MaxHeight="280">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"
                                                   Padding="0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
