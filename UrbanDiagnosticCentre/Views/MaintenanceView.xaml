<UserControl x:Class="UrbanDiagnosticCentre.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>

        <!-- Operation card -->
        <Style x:Key="OpCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.07"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Run button -->
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <!-- ===== ACCESS DENIED (non-admin) ===== -->
        <Grid Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#x1F512;" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Admin Access Required"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Maintenance tools are restricted to administrators."
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Content="← Back to Dashboard" Width="200"/>
            </StackPanel>
        </Grid>

        <!-- ===== ADMIN CONTENT ===== -->
        <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}"
                            Height="40" Padding="12,0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2190;" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Dashboard" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Maintenance" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Database diagnostics and storage management tools"
                                   FontSize="11" Foreground="#90CAF9"/>
                    </StackPanel>

                    <!-- Working indicator -->
                    <Border Grid.Column="2" VerticalAlignment="Center"
                            Background="#1AFFFFFF" CornerRadius="4" Padding="12,6"
                            Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Working…" FontSize="12" Foreground="#90CAF9"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,28,36,36">

                    <!-- Status message bar -->
                    <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,24"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"    Value="#E8F5E9"/>
                                <Setter Property="BorderBrush"   Value="#A5D6A7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Background"  Value="#FFEBEE"/>
                                        <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                        <Setter Property="Background"  Value="#E3F2FD"/>
                                        <Setter Property="BorderBrush" Value="#90CAF9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="&#x2714;"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Text"       Value="&#x26A0;"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="Text"       Value="&#x23F3;"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Section label -->
                    <TextBlock Text="DIAGNOSTIC TOOLS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <!-- 2×2 Operation cards -->
                    <Grid Margin="0,0,0,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Integrity Check -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OpCard}" Background="#E3F2FD">
                            <StackPanel>
                                <TextBlock Text="&#x1F50D;" FontSize="34" Margin="0,0,0,10"/>
                                <TextBlock Text="Integrity Check" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Runs SQLite PRAGMA integrity_check to verify the database has no corruption."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                <Button Command="{Binding IntegrityCheckCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="{StaticResource PrimaryBrush}"
                                        Content="Run Integrity Check"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Find Missing PDFs -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource OpCard}" Background="#FFF3E0">
                            <StackPanel>
                                <TextBlock Text="&#x1F4C4;" FontSize="34" Margin="0,0,0,10"/>
                                <TextBlock Text="Find Missing PDFs" FontSize="17" FontWeight="Bold"
                                           Foreground="#E65100" Margin="0,0,0,6"/>
                                <TextBlock Text="Finds reports whose PDF is recorded in the database but the file is absent on disk."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                <Button Command="{Binding FindMissingPdfsCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="#E65100"
                                        Content="Scan for Missing PDFs"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Find Orphan PDFs -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource OpCard}" Background="#EDE7F6">
                            <StackPanel>
                                <TextBlock Text="&#x1F5C3;" FontSize="34" Margin="0,0,0,10"/>
                                <TextBlock Text="Find Orphan PDFs" FontSize="17" FontWeight="Bold"
                                           Foreground="#6A1B9A" Margin="0,0,0,6"/>
                                <TextBlock Text="Finds PDF files on disk that have no matching report record in the database."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                <Button Command="{Binding FindOrphanPdfsCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="#6A1B9A"
                                        Content="Scan for Orphan PDFs"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Database Vacuum -->
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource OpCard}" Background="#E8F5E9">
                            <StackPanel>
                                <TextBlock Text="&#x1F9F9;" FontSize="34" Margin="0,0,0,10"/>
                                <TextBlock Text="Database Vacuum" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Rebuilds the database file to reclaim unused space and defragment pages."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                <Button Command="{Binding VacuumCommand}"
                                        Style="{StaticResource RunButton}"
                                        Background="{StaticResource SuccessBrush}"
                                        Content="Run Vacuum"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Result details (shown for orphan/missing PDF scans) -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24"
                            Visibility="{Binding HasResultDetails, Converter={StaticResource BoolToVisibility}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="DETAILS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding ResultDetails}" MaxHeight="280">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"
                                                   Padding="0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
