<UserControl x:Class="UrbanDiagnosticCentre.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource PrimaryBrush}" Margin="0,0,0,14"><TextBlock Text="Ω6" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="OMEGA 6.0" FontSize="18" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Hackathon Platform" FontSize="11" Foreground="#7EB3F5" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#4A6FA5" Margin="20,4,16,8"/>
                <StackPanel DockPanel.Dock="Top" Margin="8,0">
                    <Button Style="{StaticResource GhostButton}" Margin="0,2" Content="Dashboard"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToPatientsCommand}" Margin="0,2" Content="Customers"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToTestManagerCommand}" Margin="0,2" Content="Services"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToPackagesCommand}" Margin="0,2" Content="Bundles"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToAccountsCommand}" Margin="0,2" Content="Accounts"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToBackupCommand}" Margin="0,2" Content="Backup &amp; Restore"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToSettingsCommand}" Margin="0,2" Content="Settings"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToSyncSettingsCommand}" Margin="0,2" Content="Sync Settings"/>
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="#14FFFFFF" Margin="8,12"/>
                        <TextBlock Text="ADMINISTRATION" FontSize="10" FontWeight="Bold" Foreground="#4A6FA5" Margin="12,0,0,8"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateToMaintenanceCommand}" Margin="0,2" Content="Maintenance"/>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Padding="14,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"><TextBlock Text="{Binding UserInitials}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding WelcomeMessage}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="#7EB3F5"/></StackPanel>
                        <Button Grid.Column="2" Command="{Binding LogoutCommand}" Content="Sign Out" Background="Transparent" Foreground="#7EB3F5" BorderThickness="0"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32">
                <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="OMEGA 6.0" Style="{StaticResource HeadingLarge}"/><TextBlock Text="{Binding CurrentDate}" Style="{StaticResource BodyText}" Margin="0,3,0,0"/></StackPanel>
                    <Button Grid.Column="1" Command="{Binding NavigateToNewReportCommand}" Style="{StaticResource PrimaryButton}" Content="+ Create New" Width="140" Height="40"/>
                </Grid>
                <TextBlock Text="WORKSPACE OVERVIEW" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CUSTOMERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding TodayPatients}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/><TextBlock Text="created today" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="4,0,4,0"><StackPanel><TextBlock Text="SERVICES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding TodayTests}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/><TextBlock Text="selected today" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="4,0,4,0"><StackPanel><TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding ReadyReports}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/><TextBlock Text="ready to share" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="IN PROGRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding PendingReports}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/><TextBlock Text="draft items" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
                </Grid>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="24">
                    <StackPanel><TextBlock Text="RECENT ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding RecentReports}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding ReportCode}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>