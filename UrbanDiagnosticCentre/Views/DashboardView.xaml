<UserControl x:Class="UrbanDiagnosticCentre.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>

                <!-- App branding -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,20">
                    <!-- Logo badge -->
                    <Border Width="44" Height="44" CornerRadius="11"
                            Background="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="UDC" FontSize="13" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Urban Diagnostic" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Centre" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <Border Height="1" Background="#14FFFFFF" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Nav section label -->
                <TextBlock DockPanel.Dock="Top"
                           Text="NAVIGATION"
                           FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="#4A6FA5"
                           Margin="20,0,16,8"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,0">

                    <Button Style="{StaticResource GhostButton}" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontSize="17" Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Foreground="#7EB3F5"/>
                            <TextBlock Text="Dashboard" FontSize="13"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToPatientsCommand}"
                            Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontSize="15" Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Patients" FontSize="13"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToTestManagerCommand}"
                            Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9CE;" FontSize="15" Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Tests" FontSize="13"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToAccountsCommand}"
                            Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BF;" FontSize="15" Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Accounts" FontSize="13"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToBackupCommand}"
                            Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontSize="15" Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Backup &amp; Restore" FontSize="13"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToSettingsCommand}"
                            Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontSize="15" Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="13"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Admin-only section -->
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="#14FFFFFF" Margin="4,12,4,12"/>
                        <TextBlock Text="ADMINISTRATION"
                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#4A6FA5"
                                   Margin="6,0,0,8"/>

                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding NavigateToMaintenanceCommand}"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontSize="15" Width="26"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Maintenance" FontSize="13"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Rectangle DockPanel.Dock="Bottom" Height="0"/>

                <!-- User profile card -->
                <Border DockPanel.Dock="Bottom"
                        Background="#12FFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="0,1,0,0"
                        Padding="14,12"
                        Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding UserInitials}"
                                       FontSize="13" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelcomeMessage}"
                                       FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRole}"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="#7EB3F5"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Sign Out"
                                Width="32" Height="32"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="&#xE8FB;" FontSize="15"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#7EB3F5"/>
                        </Button>
                    </Grid>
                </Border>

            </DockPanel>
        </Border>

        <!-- ===== Main content ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32">

                <!-- Page header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dashboard" Style="{StaticResource HeadingLarge}"/>
                        <TextBlock Text="{Binding CurrentDate}"
                                   Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding NavigateToNewReportCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Content="+ New Report" Width="140"
                            VerticalAlignment="Center" Height="40"/>
                </Grid>

                <!-- Setup warning banner -->
                <Border BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                        Background="#FFFBEB" BorderBrush="#FCD34D"
                        Visibility="{Binding HasSetupWarning, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE946;" FontSize="17"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#B45309" Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SetupWarning}"
                                   Foreground="#92400E" FontSize="13" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="2"
                                Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="32" Padding="14,0" FontSize="12"
                                Content="Go to Settings" Margin="14,0,0,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- Disk space warning banner -->
                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                        CornerRadius="10" Padding="16,10" Margin="0,0,0,20"
                        Visibility="{Binding HasDiskSpaceWarning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontSize="15"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource WarningBrush}"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DiskSpaceWarning}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="13" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Section label: Today's Summary -->
                <TextBlock Text="TODAY'S SUMMARY"
                           FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>

                <!-- KPI Cards -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Patients Today -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="PATIENTS TODAY"
                                           FontSize="10" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Background="#EBF3FF" CornerRadius="8"
                                        Width="32" Height="32">
                                    <TextBlock Text="&#xE77B;" FontSize="15"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding TodayPatients}"
                                       FontSize="40" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       LineHeight="44"/>
                            <TextBlock Grid.Row="4"
                                       Text="registered today"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Tests Today -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="4,0,4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="TESTS TODAY"
                                           FontSize="10" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Background="#E6FAF9" CornerRadius="8"
                                        Width="32" Height="32">
                                    <TextBlock Text="&#xE9CE;" FontSize="15"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding TodayTests}"
                                       FontSize="40" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource AccentBrush}"
                                       LineHeight="44"/>
                            <TextBlock Grid.Row="4"
                                       Text="tests performed"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Reports Ready -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="4,0,4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="REPORTS READY"
                                           FontSize="10" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="8"
                                        Width="32" Height="32">
                                    <TextBlock Text="&#xE8A5;" FontSize="15"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding ReadyReports}"
                                       FontSize="40" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource SuccessBrush}"
                                       LineHeight="44"/>
                            <TextBlock Grid.Row="4"
                                       Text="ready to print"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Pending Results -->
                    <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="PENDING"
                                           FontSize="10" FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="8"
                                        Width="32" Height="32">
                                    <TextBlock Text="&#xE916;" FontSize="15"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding PendingReports}"
                                       FontSize="40" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource WarningBrush}"
                                       LineHeight="44"/>
                            <TextBlock Grid.Row="4"
                                       Text="awaiting results"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Section label: Quick Actions -->
                <TextBlock Text="QUICK ACTIONS"
                           FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- New Report -->
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                            CornerRadius="12" Padding="20,18" Margin="0,0,8,0"
                            Cursor="Hand" BorderBrush="#E2EAF8" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1"
                                              Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToNewReportCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <Border Background="#EBF3FF" CornerRadius="10"
                                    Width="40" Height="40" HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <TextBlock Text="+" FontSize="22" FontWeight="Light"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="New Report"
                                       FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Register patient &amp; create report"
                                       Style="{StaticResource BodyText}" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Backup & Restore -->
                    <Border Grid.Column="1" Background="#FFFBEB"
                            CornerRadius="12" Padding="20,18" Margin="4,0,4,0"
                            Cursor="Hand" BorderBrush="#FEF3C7" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1"
                                              Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToBackupCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <Border Background="#FEF3C7" CornerRadius="10"
                                    Width="40" Height="40" HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <TextBlock Text="&#xE74E;" FontSize="19"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Backup &amp; Restore"
                                       FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="#B45309"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Backup and restore all data"
                                       Style="{StaticResource BodyText}" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Report History -->
                    <Border Grid.Column="2" Background="#F5F3FF"
                            CornerRadius="12" Padding="20,18" Margin="4,0,4,0"
                            Cursor="Hand" BorderBrush="#EDE9FE" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1"
                                              Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToHistoryCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <Border Background="#EDE9FE" CornerRadius="10"
                                    Width="40" Height="40" HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <TextBlock Text="&#xE8C8;" FontSize="19"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Report History"
                                       FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="#6D28D9"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Search &amp; view past reports"
                                       Style="{StaticResource BodyText}" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Test Manager -->
                    <Border Grid.Column="3" Background="#F0FDF4"
                            CornerRadius="12" Padding="20,18" Margin="8,0,0,0"
                            Cursor="Hand" BorderBrush="#DCFCE7" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1"
                                              Color="#000000" Opacity="0.05"/>
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToTestManagerCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <Border Background="#DCFCE7" CornerRadius="10"
                                    Width="40" Height="40" HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <TextBlock Text="&#xE9CE;" FontSize="19"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Test Manager"
                                       FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Manage test definitions"
                                       Style="{StaticResource BodyText}" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent Reports card -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="12" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2"
                                          Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- Section header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recent Reports"
                                       Style="{StaticResource HeadingMedium}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding NavigateToNewReportCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="34" Padding="14,0" FontSize="12"
                                    Content="+ New Report"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource DividerBrush}"/>

                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding HasNoRecentReports, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,32,0,16" HorizontalAlignment="Center">
                            <TextBlock Text="No reports yet."
                                       FontSize="15" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Create the first report using the button above."
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Column headers -->
                        <Grid Margin="0,0,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoRecentReports}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Report Code"
                                       FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Padding="0,10,0,8"/>
                            <TextBlock Grid.Column="1" Text="Patient"
                                       FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Padding="0,10,0,8"/>
                            <TextBlock Grid.Column="2" Text="Test Date"
                                       FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Padding="0,10,0,8"/>
                            <TextBlock Grid.Column="3" Text="Status"
                                       FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Padding="0,10,0,8"/>
                        </Grid>

                        <!-- Report rows -->
                        <ItemsControl ItemsSource="{Binding RecentReports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid Height="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="165"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ReportCode}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PatientName}"
                                                       FontSize="13" FontFamily="Segoe UI"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TestDate, StringFormat='dd MMM yyyy'}"
                                                       FontSize="13" FontFamily="Segoe UI"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Status badge -->
                                            <Border Grid.Column="3" VerticalAlignment="Center"
                                                    CornerRadius="6" Padding="8,4"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EBF3FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Printed">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           FontFamily="Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Printed">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Print button -->
                                            <Button Grid.Column="4"
                                                    Command="{Binding DataContext.PrintReportCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Print / Export PDF"
                                                    Width="32" Height="32"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Printed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="&#xE749;" FontSize="15"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
