<UserControl x:Class="UrbanDiagnosticCentre.Views.ReportHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:UrbanDiagnosticCentre.Helpers">
<UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><helpers:StringToVisibilityConverter x:Key="StringToVisibility"/></UserControl.Resources>
<Grid Background="{StaticResource BackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="64" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}" Content="← Dashboard" Height="40" Padding="12,0" Margin="0,0,20,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Customer Records" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="Search and review your saved entries" FontSize="11" Foreground="#7EB3F5"/></StackPanel><Button Grid.Column="2" Command="{Binding NavigateToNewReportCommand}" Style="{StaticResource PrimaryButton}" Content="+ Create New" Height="40" Padding="16,0"/></Grid></Border>
<Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="18,16,18,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Border Grid.Column="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8"><TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="38" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center"/></Border><Button Grid.Column="2" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Height="38" Content="Search"/></Grid><WrapPanel Margin="0,10,0,0"><TextBlock Text="From:" Style="{StaticResource LabelText}"/><DatePicker SelectedDate="{Binding FilterFrom}" Height="34" Width="125" Margin="0,0,12,0"/><TextBlock Text="To:" Style="{StaticResource LabelText}"/><DatePicker SelectedDate="{Binding FilterTo}" Height="34" Width="125" Margin="0,0,12,0"/><TextBlock Text="Status:" Style="{StaticResource LabelText}"/><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus}" Height="34" Width="110" Margin="0,0,12,0"/><Button Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButton}" Height="34" Content="Clear" Padding="12,0"/></WrapPanel></StackPanel>
<DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" Background="{StaticResource CardBrush}" RowHeight="46"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding ReportCode}" Width="145"/><DataGridTextColumn Header="Customer" Binding="{Binding PatientName}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Reference" Binding="{Binding Age}" Width="80"/><DataGridTextColumn Header="Created" Binding="{Binding TestDate, StringFormat='dd MMM yyyy'}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110"/><DataGridTemplateColumn Header="Actions" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="View" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0"/><Button Content="Open" Command="{Binding DataContext.OpenPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
<TextBlock DockPanel.Dock="Bottom" Text="{Binding TotalCount, StringFormat={}{0} record(s)}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="18,8"/></DockPanel></Border>
<Border Grid.Column="1" Width="330" Margin="14,0,0,0" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="CUSTOMER DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Detail.PatientName}" FontSize="20" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="{Binding Detail.ReportCode}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/><TextBlock Text="CONTACT" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Detail.PhoneNumber}" Style="{StaticResource BodyText}"/><TextBlock Text="ACCOUNT OWNER" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Detail.ReferringDoctor}" Style="{StaticResource BodyText}"/><TextBlock Text="ADDRESS / NOTES" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Detail.Address}" Style="{StaticResource BodyText}"/><TextBlock Text="SELECTED SERVICES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,8"/><ItemsControl ItemsSource="{Binding Detail.Entries}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TestName}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding ResultValue}" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,4"/><TextBlock Text="{Binding Detail.TotalChargeDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><Button Command="{Binding CloseDetailCommand}" Style="{StaticResource SecondaryButton}" Content="Close" Height="40" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border>
</Grid></Grid></UserControl>